# LLM Provider Selection (Optional)
# Values: perplexity, openai
# Default: perplexity
LLM_PROVIDER=perplexity

# Shared LLM Parameters (Optional)
# Temperature: 0.0-1.0 (default: 0.7)
LLM_TEMPERATURE=0.7

# Max tokens: 100-4000 (default: 500)
LLM_MAX_TOKENS=500

# Perplexity API Key (Required when LLM_PROVIDER=perplexity)
# Get your key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# OpenAI API Key (Required when LLM_PROVIDER=openai)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Logging level
# Values: DEBUG, INFO, WARNING, ERROR
# Default: INFO
LOG_LEVEL=INFO

# Optional: Custom database path
# Default: store/whatsapp_bot.db
# DATABASE_PATH=store/whatsapp_bot.db
